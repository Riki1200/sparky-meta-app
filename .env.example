# Meta Model API (Muse Spark 1.3 & Muse Voice Transcribe)
#
# Recommended: keep the key on the server with the bundled proxy.
#   META_API_KEY=your_meta_api_key_here npm run proxy
# and point the app at it:
EXPO_PUBLIC_META_API_BASE_URL=http://localhost:8787

# Quick local testing only: calling the Meta API directly from the app.
# Anything prefixed EXPO_PUBLIC_ is embedded in the app bundle and visible to users.
# EXPO_PUBLIC_META_API_BASE_URL=https://api.meta.ai/v1
# EXPO_PUBLIC_META_API_KEY=your_meta_api_key_here
